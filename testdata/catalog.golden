              "type": "string",
              "description": "floor: pause when free space is below this size (default config guard.minFree, else 5GiB)"
            },
            "mode": {
              "type": "string",
              "description": "the rule: floor (pause below --min-free, resume above --resume-above) or allowance (pause --limit below the baseline); default config guard.mode, else floor",
              "enum": [
                "floor",
                "allowance"
              ]
            },
            "resume-above": {
              "type": "string",
              "description": "floor: resume, when the guard paused, once free space is above this size (default config guard.resumeAbove, else 20GiB)"
