    {
      "name": "terminal",
      "pin": "terminal",
      "verbs": [
        {
          "name": "attach",
          "description": "Focus a terminal: keys go to the pane until the leader detaches",
          "kind": "interaction",
          "params": {
            "id": {
              "type": "string",
              "description": "Terminal instance (defaults to the focused one)"
            }
          },
          "result": "JSON value"
        },
        {
          "name": "detach",
          "description": "Return focus to the instance around the terminal; the pane keeps running (a CloseOnDetach terminal is removed, its stream released and the focus sent to its FocusOnClose target)",
          "kind": "interaction",
          "params": {
            "id": {
              "type": "string",
              "description": "Terminal instance (defaults to the focused one)"
            }
          },
          "result": "JSON value"
        },
        {
          "name": "paste",
          "description": "Paste text into the pane, after forwarding any keys given (the leader, under it)",
          "kind": "interaction",
          "params": {
            "id": {
              "type": "string",
              "description": "Terminal instance (defaults to the focused one)"
            },
            "keys": {
              "type": "string",
              "description": "Space-separated key names forwarded before the text"
            },
            "text": {
              "type": "string",
              "required": true
            }
          },
          "result": "JSON value"
        },
        {
          "name": "send",
          "description": "Forward key names, in order, to the pane",
          "kind": "interaction",
          "params": {
            "id": {
              "type": "string",
              "description": "Terminal instance (defaults to the focused one)"
            },
            "keys": {
              "type": "string",
              "required": true,
              "description": "Space-separated key names, forwarded in order"
            }
          },
          "result": "JSON value"
        }
      ]
    },
