{
  "schema": 1,
  "name": "o-qbt",
  "version": "0.1.0",
  "state": "app.state",
  "stateDelta": 1,
  "nouns": [
    {
      "name": "actions",
      "verbs": [
        {
          "name": "list",
          "description": "List the actions installed from actions.json: verbs that run an external command",
          "kind": "interaction",
          "result": "action[]",
          "history": "fetch",
          "builtin": true
        },
        {
          "name": "path",
          "description": "Print the user actions file: actions.json beside bindings.json",
          "kind": "interaction",
          "result": "path",
          "history": "fetch",
          "builtin": true
        },
        {
          "name": "reload",
          "description": "Read actions.json again: its verbs replace the last load's, a bad entry is skipped and reported; the user bindings are applied again",
          "kind": "interaction",
          "result": "problem[]",
          "history": "fetch",
          "builtin": true
        }
      ]
    },
    {
      "name": "app",
      "verbs": [
        {
          "name": "info",
          "description": "the credentials test: log in once and read the version, Web API version, build, speeds and free disk; changes nothing",
          "kind": "application",
          "params": {
            "columns": {
              "type": "string",
              "description": "comma-separated columns, in order, for table, tsv, csv, md and toon"
            },
            "format": {
              "type": "string",
              "description": "table (the default on a terminal), json (otherwise), jsonl, tsv, csv, md or toon",
              "enum": [
                "table",
                "json",
                "jsonl",
                "tsv",
                "csv",
                "md",
                "toon"
              ]
            },
            "out": {
              "type": "string",
              "description": "write to FILE instead of printing; its extension picks the format when --format is absent"
            }
          },
          "result": "JSON value",
          "history": "fetch",
          "builtin": false
        },
        {
          "name": "prefs",
          "description": "selected preferences: save and temp paths, max active downloads/uploads/torrents, dl/up limits (bytes/s)",
          "kind": "application",
          "result": "JSON value",
          "history": "fetch",
          "builtin": false
        },
        {
          "name": "quit",
          "description": "Exit the application",
          "kind": "interaction",
          "result": "boolean",
          "history": "action",
          "builtin": true
        },
        {
          "name": "state",
          "description": "every list's rows in one call, JSON Lines {noun, id, label} for torrent and category (the catalog's state)",
          "kind": "application",
          "result": "JSON value",
          "history": "fetch",
          "builtin": false
        }
      ]
    },
    {
      "name": "bindings",
      "verbs": [
        {
          "name": "check",
          "description": "Report the rows of the user bindings file that would be skipped, and any merged row that does not validate",
          "kind": "interaction",
          "result": "problem[]",
          "history": "fetch",
          "builtin": true
        },
        {
          "name": "help",
          "description": "Open the keys the focus answers to, with the operation each runs and its description",
          "kind": "interaction",
          "result": "help row[]",
          "history": "action",
          "builtin": true
        },
        {
          "name": "list",
          "description": "List the rows the current stack and mode answer to; all includes every stored noun and instance mode table",
          "kind": "interaction",
          "params": {
            "all": {
              "type": "boolean",
              "description": "Return every stored binding row, including inactive modes and contexts, in configuration JSON format"
            }
          },
          "result": "binding[]",
          "history": "fetch",
          "builtin": true
        },
        {
          "name": "load",
          "description": "Install binding rows from a JSON file: [{noun|instance, mode, keys|pattern, request|null, from, when}]",
          "kind": "interaction",
          "params": {
            "path": {
              "type": "string",
              "required": true
            }
          },
          "result": "binding[]",
          "history": "change",
          "builtin": true
        },
        {
          "name": "path",
          "description": "Print the user bindings file: $XDG_CONFIG_HOME/\u003capp\u003e/bindings.json, else ~/.config/\u003capp\u003e/bindings.json",
          "kind": "interaction",
          "result": "path",
          "history": "fetch",
          "builtin": true
        },
        {
          "name": "reload",
          "description": "Read the user bindings file again: its rows replace or unbind the defaults, a bad row is skipped and reported",
          "kind": "interaction",
          "result": "problem[]",
          "history": "fetch",
          "builtin": true
        },
        {
          "name": "stops",
          "description": "List the rows every focus stop answers to, app-wide: each page's stops in drawing order, the open modals', then app; each with the focus and mode it is read at",
          "kind": "interaction",
          "result": "stop bindings[]",
          "history": "fetch",
          "builtin": true
        }
      ]
    },
    {
      "name": "category",
      "verbs": [
        {
          "name": "list",
          "description": "the category rows: {id: category/NAME, label: \"NAME  SAVE_PATH\", data: {name, savePath}}; --format, --columns (name, save_path), --out",
          "kind": "application",
          "params": {
            "columns": {
              "type": "string",
              "description": "comma-separated columns, in order, for table, tsv, csv, md and toon"
            },
            "format": {
              "type": "string",
              "description": "table (the default on a terminal), json (otherwise), jsonl, tsv, csv, md or toon",
              "enum": [
                "table",
                "json",
                "jsonl",
                "tsv",
                "csv",
                "md",
                "toon"
              ]
            },
            "out": {
              "type": "string",
              "description": "write to FILE instead of printing; its extension picks the format when --format is absent"
            }
          },
          "result": "JSON value",
          "rows": "category",
          "history": "fetch",
          "builtin": false
        }
      ]
    },
    {
      "name": "chooser",
      "pin": "insert",
      "verbs": [
        {
          "name": "cancel",
          "description": "Close without choosing",
          "kind": "application",
          "result": "JSON value",
          "history": "action",
          "builtin": true
        },
        {
          "name": "move",
          "description": "Move the highlight; from none, 1 lands on the first row and -1 stays",
          "kind": "application",
          "params": {
            "delta": {
              "type": "integer",
              "required": true
            }
          },
          "result": "JSON value",
          "history": "action",
          "builtin": true
        },
        {
          "name": "pick",
          "description": "Take the highlighted row, else the top match, else create from the query",
          "kind": "application",
          "result": "JSON value",
          "history": "change",
          "builtin": true
        }
      ]
    },
    {
      "name": "completion",
      "verbs": [
        {
          "name": "accept",
          "description": "Replace the token with the highlighted suggestion, else the first, keeping its trigger; one undoable edit",
          "kind": "interaction",
          "result": "JSON value",
          "history": "action",
          "builtin": true
        },
        {
          "name": "dismiss",
          "description": "Hide the suggestions; the input stays in its mode and typing reopens them",
          "kind": "interaction",
          "result": "JSON value",
          "history": "action",
          "builtin": true
        },
        {
          "name": "move",
          "description": "Move the suggestion highlight; from none, 1 lands on the first and -1 stays",
          "kind": "interaction",
          "params": {
            "delta": {
              "type": "integer",
              "required": true
            }
          },
          "result": "JSON value",
          "history": "action",
          "builtin": true
        },
        {
          "name": "open",
          "description": "Offer suggestions for the trigger token at the cursor now",
          "kind": "interaction",
          "result": "JSON value",
          "history": "action",
          "builtin": true
        }
      ]
    },
    {
      "name": "config",
      "verbs": [
        {
          "name": "export",
          "description": "Write a reference of the user configuration (every setting, every key row) into a directory, default \u003cconfig dir\u003e/reference; never over the live files without force",
          "kind": "interaction",
          "params": {
            "dir": {
              "type": "string",
              "description": "Directory to write to (default \u003cconfig dir\u003e/reference)"
            },
            "force": {
              "type": "boolean",
              "description": "Allow writing over a live config file (dir is the config directory)"
            }
          },
          "result": "export",
          "positional": [
            "dir"
          ],
          "history": "change",
          "builtin": true
        },
        {
          "name": "init",
          "description": "write the settings file (url, user admin, empty pass, volume, ssh), mode 600, unless it exists; prints its path",
          "kind": "application",
          "result": "JSON value",
          "history": "change",
          "builtin": false
        },
        {
          "name": "path",
          "description": "Print the config directory (bindings.json, settings.json, actions.json, themes.json), the state directory (history.jsonl, panes.json) and the default config export directory",
          "kind": "interaction",
          "result": "paths",
          "history": "fetch",
          "builtin": true
        },
        {
          "name": "set",
          "description": "set KEY to VALUE; pass is never taken from the command line: it prompts with echo off, or reads one line with --stdin",
          "kind": "application",
          "params": {
            "key": {
              "type": "string",
              "required": true,
              "description": "the setting",
              "enum": [
                "url",
                "user",
                "pass",
                "volume",
                "ssh",
                "guard.mode",
                "guard.minFree",
                "guard.resumeAbove"
              ]
            },
            "stdin": {
              "type": "boolean",
              "description": "read the value from one line of stdin"
            },
            "value": {
              "type": "string",
              "description": "the new value (not for pass)"
            }
          },
          "result": "JSON value",
          "positional": [
            "key",
            "value"
          ],
          "history": "change",
          "builtin": false
        },
        {
          "name": "show",
          "description": "the effective settings and the environment overrides; never the password, only whether one is set",
          "kind": "application",
          "result": "JSON value",
          "history": "fetch",
          "builtin": false
        }
      ]
    },
    {
      "name": "confirm",
      "verbs": [
        {
          "name": "accept",
          "description": "Run the request the open confirm modal holds and close it",
          "kind": "interaction",
          "result": "JSON value",
          "history": "action",
          "builtin": true
        },
        {
          "name": "set",
          "description": "Add or remove the confirm prompt of an operation ({{id}}, {{noun}}, {{label}} and {{\u003carg\u003e}} expand; a label argument wins over the instance label); an empty prompt removes it",
          "kind": "interaction",
          "params": {
            "operation": {
              "type": "string",
              "required": true,
              "description": "noun.verb"
            },
            "prompt": {
              "type": "string"
            }
          },
          "result": "operation",
          "history": "change",
          "builtin": true
        }
      ]
    },
    {
      "name": "context",
      "verbs": [
        {
          "name": "select",
          "description": "Focus an instance by id, or a nested path; omit input to leave text editing",
          "kind": "interaction",
          "params": {
            "input": {
              "type": "string"
            },
            "instance": {
              "type": "string",
              "description": "Instance ID: an input, list, row, page or modal body"
            },
            "path": {
              "type": "string",
              "description": "JSON array of instance IDs, outermost first, beginning with app (when instance is omitted)"
            }
          },
          "result": "context",
          "history": "action",
          "builtin": true
        }
      ]
    },
    {
      "name": "count",
      "verbs": [
        {
          "name": "append",
          "description": "Append a digit to the pending count",
          "kind": "interaction",
          "params": {
            "digit": {
              "type": "integer",
              "required": true
            }
          },
          "result": "count",
          "history": "action",
          "builtin": true
        }
      ]
    },
    {
      "name": "detail",
      "verbs": [
        {
          "name": "scroll",
          "description": "Scroll the page's detail by lines times count without moving the focus",
          "kind": "interaction",
          "params": {
            "count": {
              "type": "integer",
              "description": "Repeat count (default 1)"
            },
            "id": {
              "type": "string",
              "description": "The detail instance (default the first detail on the focused page)"
            },
            "lines": {
              "type": "integer",
              "description": "Lines to move, down when positive (default 1)"
            }
          },
          "result": "detail offset",
          "history": "action",
          "builtin": true
        }
      ]
    },
    {
      "name": "focus",
      "verbs": [
        {
          "name": "next",
          "description": "Move the focus to the next focus stop (or region) in drawing order, wrapping, landing on its remembered child",
          "kind": "interaction",
          "params": {
            "scope": {
              "type": "string",
              "description": "stop (default): component to component; region: panel to panel"
            },
            "steps": {
              "type": "integer",
              "description": "How many stops or regions to move (the count; default 1)"
            }
          },
          "result": "context",
          "history": "action",
          "builtin": true
        },
        {
          "name": "previous",
          "description": "Move the focus to the previous focus stop (or region) in drawing order, wrapping, landing on its remembered child",
          "kind": "interaction",
          "params": {
            "scope": {
              "type": "string",
              "description": "stop (default): component to component; region: panel to panel"
            },
            "steps": {
              "type": "integer",
              "description": "How many stops or regions to move (the count; default 1)"
            }
          },
          "result": "context",
          "history": "action",
          "builtin": true
        },
        {
          "name": "set",
          "description": "Focus an instance; the one way handlers move focus",
          "kind": "interaction",
          "params": {
            "id": {
              "type": "string",
              "required": true
            }
          },
          "result": "context",
          "history": "action",
          "builtin": true
        }
      ]
    },
    {
      "name": "form-option",
      "verbs": [
        {
          "name": "pick",
          "description": "Set the field to this choice; written at once",
          "kind": "interaction",
          "result": "JSON value",
          "history": "change",
          "builtin": true
        }
      ]
    },
    {
      "name": "form",
      "verbs": [
        {
          "name": "choose",
          "description": "Choose the field's value from its choices",
          "kind": "interaction",
          "result": "JSON value",
          "history": "action",
          "builtin": true
        },
        {
          "name": "leave",
          "description": "Leave the editor; every change is already written",
          "kind": "interaction",
          "result": "JSON value",
          "history": "action",
          "builtin": true
        },
        {
          "name": "next",
          "description": "Focus the next field; the field left is written",
          "kind": "interaction",
          "params": {
            "insert": {
              "type": "boolean",
              "description": "keep typing when the field is a text field"
            }
          },
          "result": "JSON value",
          "history": "action",
          "builtin": true
        },
        {
          "name": "previous",
          "description": "Focus the previous field; the field left is written",
          "kind": "interaction",
          "params": {
            "insert": {
              "type": "boolean",
              "description": "keep typing when the field is a text field"
            }
          },
          "result": "JSON value",
          "history": "action",
          "builtin": true
        },
        {
          "name": "redo",
          "description": "Redo the record's last undone change",
          "kind": "interaction",
          "result": "JSON value",
          "history": "change",
          "builtin": true
        },
        {
          "name": "suggest",
          "description": "Fill the field from its suggestions; typing stays free",
          "kind": "interaction",
          "result": "JSON value",
          "history": "change",
          "builtin": true
        },
        {
          "name": "undo",
          "description": "Undo the record's last change; the undo is written like any change",
          "kind": "interaction",
          "result": "JSON value",
          "history": "change",
          "builtin": true
        }
      ]
    },
    {
      "name": "guard",
      "verbs": [
        {
          "name": "check",
          "description": "the monitor step: df the volume over ssh; floor mode (default) pauses every torrent when free space is below --min-free (5GiB) and resumes them above --resume-above (20GiB) when the guard paused; allowance mode pauses once free space is more than --limit below the baseline; one line to guard.log",
          "kind": "application",
          "params": {
            "limit": {
              "type": "string",
              "description": "allowance: how far free space may drop below the baseline: bytes, or a number with K, M, G or T (default 10G)"
            },
            "min-free": {
              "type": "string",
              "description": "floor: pause when free space is below this size (default config guard.minFree, else 5GiB)"
            },
            "mode": {
              "type": "string",
              "description": "the rule: floor (pause below --min-free, resume above --resume-above) or allowance (pause --limit below the baseline); default config guard.mode, else floor",
              "enum": [
                "floor",
                "allowance"
              ]
            },
            "resume-above": {
              "type": "string",
              "description": "floor: resume, when the guard paused, once free space is above this size (default config guard.resumeAbove, else 20GiB)"
            }
          },
          "result": "JSON value",
          "history": "change",
          "builtin": false
        },
        {
          "name": "install",
          "description": "write ~/Library/LaunchAgents/com.unixsuperhero.o-qbt-guard.plist (o-qbt guard check every 300 s and at load), lint it, bootstrap it in gui/UID; idempotent",
          "kind": "application",
          "result": "JSON value",
          "history": "change",
          "builtin": false
        },
        {
          "name": "log",
          "description": "the last --tail N lines of guard.log (default 20)",
          "kind": "application",
          "params": {
            "tail": {
              "type": "integer",
              "description": "how many lines (default 20)"
            }
          },
          "result": "JSON value",
          "positional": [
            "tail"
          ],
          "history": "fetch",
          "builtin": false
        },
        {
          "name": "rebase",
          "description": "store the current free space as the baseline (or --bytes N) and clear the marker; only allowance mode reads the baseline",
          "kind": "application",
          "params": {
            "bytes": {
              "type": "integer",
              "description": "the baseline in bytes instead of the current free space"
            },
            "limit": {
              "type": "string",
              "description": "allowance: how far free space may drop below the baseline: bytes, or a number with K, M, G or T (default 10G)"
            },
            "min-free": {
              "type": "string",
              "description": "floor: pause when free space is below this size (default config guard.minFree, else 5GiB)"
            },
            "mode": {
              "type": "string",
              "description": "the rule: floor (pause below --min-free, resume above --resume-above) or allowance (pause --limit below the baseline); default config guard.mode, else floor",
              "enum": [
                "floor",
                "allowance"
              ]
            },
            "resume-above": {
              "type": "string",
              "description": "floor: resume, when the guard paused, once free space is above this size (default config guard.resumeAbove, else 20GiB)"
            }
          },
          "result": "JSON value",
          "history": "change",
          "builtin": false
        },
        {
          "name": "resume",
          "description": "resume every torrent and clear the marker",
          "kind": "application",
          "params": {
            "limit": {
              "type": "string",
              "description": "allowance: how far free space may drop below the baseline: bytes, or a number with K, M, G or T (default 10G)"
            },
            "min-free": {
              "type": "string",
              "description": "floor: pause when free space is below this size (default config guard.minFree, else 5GiB)"
            },
            "mode": {
              "type": "string",
              "description": "the rule: floor (pause below --min-free, resume above --resume-above) or allowance (pause --limit below the baseline); default config guard.mode, else floor",
              "enum": [
                "floor",
                "allowance"
              ]
            },
            "resume-above": {
              "type": "string",
              "description": "floor: resume, when the guard paused, once free space is above this size (default config guard.resumeAbove, else 20GiB)"
            }
          },
          "result": "JSON value",
          "history": "change",
          "builtin": false
        },
        {
          "name": "status",
          "description": "the launchd agent, the last guard.log line, the mode and its thresholds, free space (against the baseline in allowance mode), whether the guard paused",
          "kind": "application",
          "params": {
            "limit": {
              "type": "string",
              "description": "allowance: how far free space may drop below the baseline: bytes, or a number with K, M, G or T (default 10G)"
            },
            "min-free": {
              "type": "string",
              "description": "floor: pause when free space is below this size (default config guard.minFree, else 5GiB)"
            },
            "mode": {
              "type": "string",
              "description": "the rule: floor (pause below --min-free, resume above --resume-above) or allowance (pause --limit below the baseline); default config guard.mode, else floor",
              "enum": [
                "floor",
                "allowance"
              ]
            },
            "resume-above": {
              "type": "string",
              "description": "floor: resume, when the guard paused, once free space is above this size (default config guard.resumeAbove, else 20GiB)"
            }
          },
          "result": "JSON value",
          "history": "fetch",
          "builtin": false
        },
        {
          "name": "uninstall",
          "description": "bootout the agent and remove its plist; the baseline, marker and log stay",
          "kind": "application",
          "result": "JSON value",
          "history": "change",
          "builtin": false
        }
      ]
    },
    {
      "name": "history",
      "verbs": [
        {
          "name": "list",
          "description": "List the last executed requests, oldest first, with their kind, context, source and result; by default the user's actions and changes",
          "kind": "interaction",
          "params": {
            "kind": {
              "type": "string",
              "description": "Kinds separated by commas (action, change, fetch, system) or all; default action,change"
            },
            "last": {
              "type": "integer",
              "description": "How many entries (default 50, 0 for all)"
            }
          },
          "result": "history[]",
          "history": "fetch",
          "builtin": true
        },
        {
          "name": "path",
          "description": "Print the history file: $XDG_STATE_HOME/\u003capp\u003e/history.jsonl, else ~/.local/state/\u003capp\u003e/history.jsonl",
          "kind": "interaction",
          "result": "path",
          "history": "fetch",
          "builtin": true
        },
        {
          "name": "repeat",
          "description": "Dot-repeat: run the last repeatable change again at the current focus, its arguments kept; steps replaces its count",
          "kind": "interaction",
          "params": {
            "steps": {
              "type": "integer",
              "description": "Count replacing the recorded one; 0 keeps it"
            }
          },
          "result": "JSON value",
          "history": "action",
          "builtin": true
        }
      ]
    },
    {
      "name": "input",
      "verbs": [
        {
          "name": "begin",
          "description": "Enter insert mode at insert/append/first/end/below/above",
          "kind": "interaction",
          "params": {
            "position": {
              "type": "string"
            }
          },
          "result": "input state",
          "history": "action",
          "builtin": true
        },
        {
          "name": "cancel",
          "description": "Cancel the pending count, operator, prefix or register of the focused instance; a visual selection returns to normal",
          "kind": "interaction",
          "result": "mode",
          "history": "action",
          "builtin": true
        },
        {
          "name": "delete",
          "description": "Delete forward/backward runes without crossing a normal-mode line",
          "kind": "interaction",
          "params": {
