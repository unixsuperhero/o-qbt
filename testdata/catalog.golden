{
  "schema": 1,
  "name": "o-qbt",
  "version": "0.1.0",
  "state": "app.state",
  "nouns": [
    {
      "name": "app",
      "verbs": [
        {
          "name": "info",
          "description": "the credentials test: log in once and read the version, Web API version, build, speeds and free disk; changes nothing",
          "kind": "application",
          "params": {
            "columns": {
              "type": "string",
              "description": "comma-separated columns, in order, for table, tsv, csv, md and toon"
            },
            "format": {
              "type": "string",
              "description": "table (the default on a terminal), json (otherwise), jsonl, tsv, csv, md or toon",
              "enum": [
                "table",
                "json",
                "jsonl",
                "tsv",
                "csv",
                "md",
                "toon"
              ]
            },
            "out": {
              "type": "string",
              "description": "write to FILE instead of printing; its extension picks the format when --format is absent"
            }
          },
          "result": "JSON value"
        },
        {
          "name": "prefs",
          "description": "selected preferences: save and temp paths, max active downloads/uploads/torrents, dl/up limits (bytes/s)",
          "kind": "application",
          "result": "JSON value"
        },
        {
          "name": "quit",
          "description": "Exit the application",
          "kind": "interaction",
          "result": "boolean"
        },
        {
          "name": "state",
          "description": "every list's rows in one call, JSON Lines {noun, id, label} for torrent and category (the catalog's state)",
          "kind": "application",
          "result": "JSON value"
        }
      ]
    },
    {
      "name": "bindings",
      "verbs": [
        {
          "name": "help",
          "description": "Open the keys the focus answers to, with the operation each runs and its description",
          "kind": "interaction",
          "result": "help row[]"
        },
        {
          "name": "list",
          "description": "List the rows the current stack and mode answer to, pending modes included",
          "kind": "interaction",
          "result": "binding[]"
        },
        {
          "name": "load",
          "description": "Install binding rows from a JSON file: [{noun|instance, mode, keys|pattern, request|null, from, when}]",
          "kind": "interaction",
          "params": {
            "path": {
              "type": "string",
              "required": true
            }
          },
          "result": "binding[]"
        }
      ]
    },
    {
      "name": "category",
      "verbs": [
        {
          "name": "list",
          "description": "the category rows: {id: category/NAME, label: \"NAME  SAVE_PATH\", data: {name, savePath}}; --format, --columns (name, save_path), --out",
          "kind": "application",
          "params": {
            "columns": {
              "type": "string",
              "description": "comma-separated columns, in order, for table, tsv, csv, md and toon"
            },
            "format": {
              "type": "string",
              "description": "table (the default on a terminal), json (otherwise), jsonl, tsv, csv, md or toon",
              "enum": [
                "table",
                "json",
                "jsonl",
                "tsv",
                "csv",
                "md",
                "toon"
              ]
            },
            "out": {
              "type": "string",
              "description": "write to FILE instead of printing; its extension picks the format when --format is absent"
            }
          },
          "result": "JSON value",
          "rows": "category"
        }
      ]
    },
    {
      "name": "config",
      "verbs": [
        {
          "name": "init",
          "description": "write the settings file (url, user admin, empty pass, volume, ssh), mode 600, unless it exists; prints its path",
          "kind": "application",
          "result": "JSON value"
        },
        {
          "name": "set",
          "description": "set KEY to VALUE; pass is never taken from the command line: it prompts with echo off, or reads one line with --stdin",
          "kind": "application",
          "params": {
            "key": {
              "type": "string",
              "required": true,
              "description": "the setting",
              "enum": [
                "url",
                "user",
                "pass",
                "volume",
                "ssh"
              ]
            },
            "stdin": {
              "type": "boolean",
              "description": "read the value from one line of stdin"
            },
            "value": {
              "type": "string",
              "description": "the new value (not for pass)"
            }
          },
          "result": "JSON value",
          "positional": [
            "key",
            "value"
          ]
        },
        {
          "name": "show",
          "description": "the effective settings and the environment overrides; never the password, only whether one is set",
          "kind": "application",
          "result": "JSON value"
        }
      ]
    },
    {
      "name": "confirm",
      "verbs": [
        {
          "name": "accept",
          "description": "Run the request the open confirm modal holds and close it",
          "kind": "interaction",
          "result": "JSON value"
        },
        {
          "name": "set",
          "description": "Add or remove the confirm prompt of an operation ({{id}}, {{noun}}, {{label}} and {{\u003carg\u003e}} expand; a label argument wins over the instance label); an empty prompt removes it",
          "kind": "interaction",
          "params": {
            "operation": {
              "type": "string",
              "required": true,
              "description": "noun.verb"
            },
            "prompt": {
              "type": "string"
            }
          },
          "result": "operation"
        }
      ]
    },
    {
      "name": "context",
      "verbs": [
        {
          "name": "select",
          "description": "Focus an instance by id, or a nested path; omit input to leave text editing",
          "kind": "interaction",
          "params": {
            "input": {
              "type": "string"
            },
            "instance": {
              "type": "string",
              "description": "Instance ID: an input, list, row, page or modal body"
            },
            "path": {
              "type": "string",
              "description": "JSON array of instance IDs, outermost first, beginning with app (when instance is omitted)"
            }
          },
          "result": "context"
        }
      ]
    },
    {
      "name": "count",
      "verbs": [
        {
          "name": "append",
          "description": "Append a digit to the pending count",
          "kind": "interaction",
          "params": {
            "digit": {
              "type": "integer",
              "required": true
            }
          },
          "result": "count"
        }
      ]
    },
    {
      "name": "focus",
      "verbs": [
        {
          "name": "next",
          "description": "Move the focus to the next focus stop (or region) in drawing order, wrapping, landing on its remembered child",
          "kind": "interaction",
          "params": {
            "scope": {
              "type": "string",
              "description": "stop (default): component to component; region: panel to panel"
            },
            "steps": {
              "type": "integer",
              "description": "How many stops or regions to move (the count; default 1)"
            }
          },
          "result": "context"
        },
        {
          "name": "previous",
          "description": "Move the focus to the previous focus stop (or region) in drawing order, wrapping, landing on its remembered child",
          "kind": "interaction",
          "params": {
            "scope": {
              "type": "string",
              "description": "stop (default): component to component; region: panel to panel"
            },
            "steps": {
              "type": "integer",
              "description": "How many stops or regions to move (the count; default 1)"
            }
          },
          "result": "context"
        },
        {
          "name": "set",
          "description": "Focus an instance; the one way handlers move focus",
          "kind": "interaction",
          "params": {
            "id": {
              "type": "string",
              "required": true
            }
          },
          "result": "context"
        }
      ]
    },
    {
      "name": "guard",
      "verbs": [
        {
          "name": "check",
          "description": "the monitor step: df the volume over ssh; pause every torrent once free space is more than --limit below the baseline, write the marker; one line to guard.log",
          "kind": "application",
          "params": {
            "limit": {
              "type": "string",
              "description": "how far free space may drop below the baseline: bytes, or a number with K, M, G or T (default 10G)"
            }
          },
          "result": "JSON value"
        },
        {
          "name": "install",
          "description": "write ~/Library/LaunchAgents/com.unixsuperhero.o-qbt-guard.plist (o-qbt guard check every 300 s and at load), lint it, bootstrap it in gui/UID; idempotent",
          "kind": "application",
          "result": "JSON value"
        },
        {
          "name": "log",
          "description": "the last --tail N lines of guard.log (default 20)",
          "kind": "application",
          "params": {
            "tail": {
              "type": "integer",
              "description": "how many lines (default 20)"
            }
          },
          "result": "JSON value",
          "positional": [
            "tail"
          ]
        },
        {
          "name": "rebase",
          "description": "store the current free space as the baseline (or --bytes N) and clear the marker",
          "kind": "application",
          "params": {
            "bytes": {
              "type": "integer",
              "description": "the baseline in bytes instead of the current free space"
            },
            "limit": {
              "type": "string",
              "description": "how far free space may drop below the baseline: bytes, or a number with K, M, G or T (default 10G)"
            }
          },
          "result": "JSON value"
        },
        {
          "name": "resume",
          "description": "resume every torrent and clear the marker",
          "kind": "application",
          "params": {
            "limit": {
              "type": "string",
              "description": "how far free space may drop below the baseline: bytes, or a number with K, M, G or T (default 10G)"
            }
          },
          "result": "JSON value"
        },
        {
          "name": "status",
          "description": "the launchd agent, the last guard.log line, free space against the baseline and limit, the marker",
          "kind": "application",
          "params": {
            "limit": {
              "type": "string",
              "description": "how far free space may drop below the baseline: bytes, or a number with K, M, G or T (default 10G)"
            }
          },
          "result": "JSON value"
        },
        {
          "name": "uninstall",
          "description": "bootout the agent and remove its plist; the baseline, marker and log stay",
          "kind": "application",
          "result": "JSON value"
        }
      ]
    },
    {
      "name": "history",
      "verbs": [
        {
          "name": "list",
          "description": "List the last executed requests, oldest first, with their context, source and result",
          "kind": "interaction",
          "params": {
            "last": {
              "type": "integer",
              "description": "How many entries (default 50, 0 for all)"
            }
          },
          "result": "history[]"
        },
        {
          "name": "repeat",
          "description": "Dot-repeat: run the last repeatable change again at the current focus, its arguments kept; steps replaces its count",
          "kind": "interaction",
          "params": {
            "steps": {
              "type": "integer",
              "description": "Count replacing the recorded one; 0 keeps it"
            }
          },
          "result": "JSON value"
        }
      ]
    },
    {
      "name": "input",
      "verbs": [
        {
          "name": "begin",
          "description": "Enter insert mode at insert/append/first/end/below/above",
          "kind": "interaction",
          "params": {
            "position": {
              "type": "string"
            }
          },
          "result": "input state"
        },
        {
          "name": "cancel",
          "description": "Cancel the pending count, operator, prefix or register of the focused instance; a visual selection returns to normal",
          "kind": "interaction",
          "result": "mode"
        },
        {
          "name": "delete",
          "description": "Delete forward/backward runes without crossing a normal-mode line",
          "kind": "interaction",
          "params": {
            "direction": {
              "type": "string"
            },
            "steps": {
              "type": "integer"
            }
          },
          "result": "input state",
          "repeatable": true
        },
        {
          "name": "focus",
          "description": "Focus a registered input",
          "kind": "interaction",
          "params": {
            "id": {
              "type": "string",
              "required": true
            }
          },
          "result": "context"
        },
        {
          "name": "insert",
          "description": "Insert literal text at the rune cursor",
          "kind": "interaction",
          "params": {
            "text": {
              "type": "string",
              "required": true
            }
          },
          "result": "input state",
          "repeatable": true
        },
        {
          "name": "kill",
          "description": "Kill preceding WORD/path component or line into shared yank history",
          "kind": "interaction",
          "params": {
            "motion": {
              "type": "string",
              "required": true
            }
          },
          "result": "editor state",
          "repeatable": true
        },
        {
          "name": "move",
          "description": "Move by left/right/up/down, Vim word-forward/backward/end, Readline word-next/previous, line-start/end, first-line/last-line",
          "kind": "interaction",
          "params": {
            "line": {
              "type": "integer"
            },
            "motion": {
              "type": "string",
              "required": true
            },
            "steps": {
              "type": "integer"
            }
          },
          "result": "input state"
        },
        {
          "name": "operator",
          "description": "Yank, delete, or change a selection, whole lines, or an existing motion",
          "kind": "interaction",
          "params": {
            "line": {
              "type": "integer"
            },
            "motion": {
              "type": "string"
            },
            "operator": {
              "type": "string",
              "required": true
            },
            "register": {
              "type": "string"
            },
            "steps": {
              "type": "integer"
            }
          },
          "result": "editor state",
          "repeatable": true
        },
        {
          "name": "paste",
          "description": "Paste a shared register preserving its shape; literal inserts at cursor",
          "kind": "interaction",
          "params": {
            "before": {
              "type": "boolean"
            },
            "literal": {
              "type": "boolean"
            },
            "register": {
              "type": "string"
            },
            "steps": {
              "type": "integer"
            }
          },
          "result": "editor state",
          "repeatable": true
        },
        {
          "name": "redo",
          "description": "Redo changes; branch is a zero-based child index for the first step",
          "kind": "interaction",
          "params": {
            "branch": {
              "type": "integer"
            },
            "steps": {
              "type": "integer"
            }
          },
          "result": "input state"
        },
        {
          "name": "replace",
          "description": "Replace a half-open rune range",
          "kind": "interaction",
          "params": {
            "end": {
              "type": "integer",
              "required": true
            },
            "start": {
              "type": "integer",
              "required": true
            },
            "text": {
              "type": "string",
              "required": true
            }
          },
          "result": "input state",
          "repeatable": true
        },
        {
          "name": "select",
          "description": "Start or toggle character, line, or block visual selection",
          "kind": "interaction",
          "params": {
            "shape": {
              "type": "string"
            }
          },
          "result": "editor state"
        },
        {
          "name": "undo",
          "description": "Undo changes in this input",
          "kind": "interaction",
          "params": {
            "steps": {
              "type": "integer"
            }
          },
          "result": "input state"
        },
        {
          "name": "yank",
          "description": "Yank visual selection or whole current lines",
          "kind": "interaction",
          "params": {
            "register": {
              "type": "string"
            },
            "steps": {
              "type": "integer"
            }
          },
          "result": "editor state"
        }
      ]
    },
    {
      "name": "instances",
      "verbs": [
        {
          "name": "query",
          "description": "List the instances matching every predicate, in tree order: where is [[name, arg], ...] with noun, id, kind, within, child-of, focusable, region, state, registered predicates, and [any|all|not, [...]]",
          "kind": "interaction",
          "params": {
            "where": {
              "type": "array",
              "description": "Predicates, ANDed"
            }
          },
          "result": "instance[]"
        }
      ]
    },
    {
      "name": "jobs",
      "verbs": [
        {
          "name": "list",
          "description": "List off-loop jobs: running ones and those finished since the last read (done, failed or cancelled, with the error)",
          "kind": "interaction",
          "result": "job[]"
        }
      ]
    },
    {
      "name": "key",
      "verbs": [
        {
          "name": "dispatch",
          "description": "Dispatch one key through the stack walk; mode \"shadow\" resolves it in the runtime's own mode beneath a macro recording, so the key is recorded once, and another mode name resolves it in that mode",
          "kind": "interaction",
          "params": {
            "key": {
              "type": "string",
              "required": true,
              "description": "Key name as bindings spell it; for a paste, the bracketed text"
            },
            "mode": {
              "type": "string",
              "description": "Empty for the live walk, \"shadow\" or a mode name"
            },
            "paste": {
              "type": "boolean",
              "description": "The key is pasted text"
            }
          },
          "result": "boolean"
        },
        {
          "name": "ignore",
          "description": "Consume a key without effect; the row a noun binds to swallow keys",
          "kind": "interaction",
          "result": "null"
        }
      ]
    },
    {
      "name": "list",
      "verbs": [
        {
          "name": "apply",
          "description": "Run \u003crow noun\u003e.verb for every marked row (the selected row when none is marked), skipping and reporting rows whose noun lacks the verb",
          "kind": "interaction",
          "params": {
            "id": {
              "type": "string"
            },
            "verb": {
              "type": "string",
              "required": true
            }
          },
          "result": "list state"
        },
        {
          "name": "focus",
          "description": "Focus a list and its selected row",
          "kind": "interaction",
          "params": {
            "id": {
              "type": "string",
              "required": true
            }
          },
          "result": "list state"
        },
        {
          "name": "mark",
          "description": "Toggle the mark on a row (the selected row by default) for fan-out verbs",
          "kind": "interaction",
          "params": {
            "id": {
              "type": "string"
            },
            "item": {
              "type": "string"
            }
          },
          "result": "list state"
        },
        {
          "name": "move",
          "description": "Move the selection; past the edge, on to the next stop on the page",
          "kind": "interaction",
          "params": {
            "delta": {
              "type": "integer",
              "required": true
            },
            "id": {
              "type": "string"
            }
          },
          "result": "list state"
        },
        {
          "name": "select",
          "description": "Select a list item by stable ID without stealing focus",
          "kind": "interaction",
          "params": {
            "id": {
              "type": "string"
            },
            "item": {
              "type": "string",
              "required": true
            }
          },
          "result": "list state"
        }
      ]
    },
    {
      "name": "macro",
      "verbs": [
        {
          "name": "append",
          "description": "Append one key to the macro being recorded",
          "kind": "interaction",
          "params": {
            "key": {
              "type": "string",
              "required": true,
              "description": "Key name as bindings spell it; for a paste, the bracketed text"
            },
            "paste": {
              "type": "boolean",
              "description": "The key is pasted text"
            }
          },
          "result": "macro state"
        },
        {
          "name": "record",
          "description": "Record one key: append it to the recording, then dispatch it in the shadowed mode (macro.append, then key.dispatch)",
          "kind": "interaction",
          "params": {
            "key": {
              "type": "string",
              "required": true,
              "description": "Key name as bindings spell it; for a paste, the bracketed text"
            },
            "paste": {
              "type": "boolean",
              "description": "The key is pasted text"
            }
          },
          "result": "macro state"
        },
        {
          "name": "replay",
          "description": "Replay a register through application dispatch; @ repeats last macro",
          "kind": "interaction",
          "params": {
            "register": {
              "type": "string",
              "required": true
            },
            "steps": {
              "type": "integer"
            }
          },
          "result": "macro state"
        },
        {
          "name": "start",
          "description": "Record application keys into a named register",
          "kind": "interaction",
          "params": {
            "register": {
              "type": "string",
              "required": true
            }
          },
          "result": "macro state"
        },
        {
          "name": "stop",
          "description": "Finish the current macro recording",
          "kind": "interaction",
          "result": "macro state"
        }
      ]
    },
    {
      "name": "modal",
      "verbs": [
        {
          "name": "pop",
          "description": "Close the active modal and restore its parent",
          "kind": "interaction",
          "result": "context"
        },
        {
          "name": "push",
          "description": "Open a modal focused on a registered input",
          "kind": "interaction",
          "params": {
            "id": {
              "type": "string",
              "required": true
            },
            "input": {
              "type": "string",
              "required": true
            }
          },
          "result": "context"
        }
      ]
    },
    {
      "name": "mode",
      "verbs": [
        {
          "name": "enter",
          "description": "Enter a pending mode with a typed payload (op, count, opcount; prefix arms the sequence timer, request is what it runs)",
          "kind": "interaction",
          "params": {
            "count": {
              "type": "integer"
            },
            "mode": {
              "type": "string",
              "required": true
            },
            "op": {
              "type": "string"
            },
            "opcount": {
              "type": "integer"
            },
            "prefix": {
              "type": "string",
              "description": "Key sequence the mode holds; the timer runs request when no key follows"
            },
            "request": {
              "type": "object",
              "description": "Request run when the sequence times out"
            }
          },
          "result": "mode"
        },
        {
          "name": "leave",
          "description": "Return from a pending mode to the mode it shadowed",
          "kind": "interaction",
          "result": "mode"
        },
        {
          "name": "register",
          "description": "Register an application-defined mode name; pending modes are exclusive and one-shot",
          "kind": "interaction",
          "params": {
            "name": {
              "type": "string",
              "required": true
            },
            "pending": {
              "type": "boolean"
            }
          },
          "result": "mode"
        },
        {
          "name": "set",
          "description": "Set the global interaction mode (a registered mode) and clear any pending payload",
          "kind": "interaction",
          "params": {
            "mode": {
              "type": "string",
              "required": true
            }
          },
          "result": "mode"
        }
      ]
    },
    {
      "name": "modes",
      "verbs": [
        {
          "name": "list",
          "description": "List registered interaction modes, pending modes included",
          "kind": "interaction",
          "result": "string[]"
        }
      ]
    },
    {
      "name": "operations",
      "verbs": [
        {
          "name": "list",
          "description": "List registered verbs, nouns, kinds (interaction or application), confirm prompts and argument schemas",
          "kind": "interaction",
          "result": "operation[]"
        }
      ]
    },
    {
      "name": "page",
      "verbs": [
        {
          "name": "next",
          "description": "Open the next page, wrapping in registration order",
          "kind": "interaction",
          "result": "context"
        },
        {
          "name": "open",
          "description": "Open a registered page",
          "kind": "interaction",
          "params": {
