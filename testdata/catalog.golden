              "source": "ochazuke.page.list",
              "free": true,
              "noun": "ochazuke.page",
              "focus": true
            },
            "pairs": {
              "type": "string",
              "description": "More prop=value words after prop and value (the several-prop form)",
              "rest": true
            },
            "prop": {
              "type": "string",
              "description": "The prop to write (with value or toggle); a prop=value word starts the several-prop form",
              "enum": [
                "hidden"
              ],
              "free": true,
              "pairs": true
            },
            "toggle": {
              "type": "boolean",
              "description": "Flip the boolean prop instead of giving a value",
              "excludes": [
