      "noun": "ochazuke.chooser",
      "keys": "alt+o",
      "request": {
        "verb": "previous-source",
        "noun": "ochazuke.chooser"
      }
    },
    {
      "noun": "ochazuke.chooser",
      "keys": "alt+up",
      "request": {
        "verb": "up",
        "noun": "ochazuke.chooser"
      }
    },
    {
      "noun": "ochazuke.chooser",
      "keys": "backspace",
      "request": {
        "verb": "up",
        "noun": "ochazuke.chooser"
      },
      "when": "chooser-up-empty"
    },
    {
      "noun": "ochazuke.chooser",
