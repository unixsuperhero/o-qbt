              "type": "string",
              "description": "Actor kind (owner, agent, unknown), self, or exact actor JSON; empty means all"
            },
            "kind": {
              "type": "string",
              "description": "Kinds separated by commas (action, change, fetch, system) or all; default action,change"
            },
            "last": {
              "type": "integer",
              "description": "How many entries (default 50, 0 for all)"
            },
            "limit": {
              "type": "integer",
              "description": "How many matching entries; overrides last"
            }
          },
          "result": "history[]",
          "history": "fetch",
          "builtin": true
