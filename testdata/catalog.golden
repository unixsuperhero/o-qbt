              "type": "string",
              "description": "write to FILE instead of printing; its extension picks the format when --format is absent"
            },
            "reverse": {
              "type": "boolean",
              "description": "reverse the order"
            },
            "sort": {
              "type": "string",
              "description": "sort by this field on the server (default name, here)",
