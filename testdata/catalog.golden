                "progress",
                "ratio",
                "size",
                "state",
                "upspeed"
              ]
            },
            "tag": {
              "type": "string",
              "description": "only this tag (\"\" = untagged)"
            }
          },
          "result": "JSON value",
          "history": "fetch",
          "builtin": false
