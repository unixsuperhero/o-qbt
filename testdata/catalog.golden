    {
      "noun": "ochazuke.chooser",
      "pattern": "printable",
      "request": {
        "verb": "insert",
        "noun": "ochazuke.input"
      },
      "from": {
        "text": "text"
      },
      "hidden": true
    },
    {
      "noun": "ochazuke.chooser",
      "pattern": "paste",
      "request": {
        "verb": "insert",
        "noun": "ochazuke.input"
      },
      "from": {
        "text": "text"
      },
      "hidden": true
    },
    {
      "noun": "ochazuke.chooser",
      "keys": "alt+[",
      "request": {
        "verb": "filter-cycle",
        "noun": "ochazuke.list",
        "args": {
          "step": -1
        }
      },
      "hint": "previous filter",
      "hidden": true
    },
    {
      "noun": "ochazuke.chooser",
      "keys": "alt+]",
      "request": {
        "verb": "filter-cycle",
        "noun": "ochazuke.list",
        "args": {
          "step": 1
        }
      },
      "hint": "next filter"
    },
    {
      "noun": "ochazuke.chooser",
      "keys": "alt+backspace",
      "request": {
        "verb": "filter-props-clear",
        "noun": "ochazuke.list"
      },
      "hint": "clear props"
    },
    {
      "noun": "ochazuke.chooser",
      "keys": "alt+enter",
      "request": {
        "verb": "pick",
        "noun": "ochazuke.chooser"
