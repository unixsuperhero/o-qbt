          "kind": "application",
          "params": {
            "id": {
              "type": "string",
              "description": "The page's id (default: the page the request acts for)",
              "source": "ochazuke.page.list",
              "free": true,
              "noun": "ochazuke.page",
              "focus": true
            },
            "prop": {
              "type": "string",
              "description": "One prop: answer its value alone",
              "enum": [
                "id",
                "title",
                "hidden",
                "active"
              ]
            },
            "props": {
              "type": "string",
              "description": "The props to answer, comma-separated (default: every prop but secrets)"
            }
          },
