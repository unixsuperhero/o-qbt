          "name": "complete",
          "description": "Complete a :set line at the cursor: setting names (noNAME and invNAME for on/off ones, all, all\u0026), the current value after =, an enum's values, true and false, a list's items after -=; each id is the line up to the cursor completed",
          "kind": "interaction",
          "params": {
            "cursor": {
              "type": "integer",
              "description": "The cursor, a character offset into the line (default: its end)"
